<?xml version="1.0" encoding="utf-8"?>
<!-- 悬浮窗/详情窗背景（XML 兜底；运行期由 OverlayTheme.background() 按主题重绘）：
     玻璃底 72% + 上沿高光 + 顶部微渐变，圆角 20dp -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/qi_r_xl" />
            <solid android:color="@color/qi_glass" />
            <stroke
                android:width="1dp"
                android:color="#24FFFFFF" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/qi_r_xl" />
            <gradient
                android:angle="270"
                android:centerY="0.42"
                android:endColor="#00FFFFFF"
                android:startColor="#12FFFFFF"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
